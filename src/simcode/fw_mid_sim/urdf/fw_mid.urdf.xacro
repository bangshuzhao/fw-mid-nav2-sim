<?xml version="1.0"?>
<robot name="fw_mid" xmlns:xacro="http://www.ros.org/wiki/xacro"> 
  <xacro:arg name="geometry_file" default="$(find fw_mid_sim)/config/geometry.yaml"/>
  <xacro:arg name="controllers_file" default="$(find fw_mid_sim)/config/controllers.yaml"/>
  <xacro:property name="geometry_file" value="$(arg geometry_file)"/>
  <xacro:property name="geom" value="${xacro.load_yaml(geometry_file)}"/>
  <xacro:arg name="sensor_file" default="$(find fw_mid_sim)/config/sensors.yaml"/>
  <xacro:property name="sensor_file" value="$(arg sensor_file)"/>
  <xacro:property name="sensor" value="${xacro.load_yaml(sensor_file)}"/>


  <xacro:property name="mesh_path" value="package://fw_mid_sim/meshes"/>
  <xacro:include filename="photo_details.xacro"/>

  <link name="base_footprint"/>
  <link name="base_link">
    <xacro:chassis_finish/>
    <collision>
      <origin xyz="0 0 0.165"/>
      <geometry><box size="0.68 0.55 0.22"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.145"/>
      <mass value="52"/>
      <inertia ixx="2.15" ixy="0" ixz="0" iyy="2.84" iyz="0" izz="3.31"/>
    </inertial>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${geom.wheel_radius}"/>
  </joint>

  <xacro:macro name="wheel" params="name x y">
    <xacro:property name="side" value="${1 if y > 0 else -1}"/>
    <link name="${name}_knuckle">
      <xacro:detail_mesh name="${name}_yoke" file="steering_yoke" color="${charcoal}"
        xyz="0 ${-side*(geom.wheel_width/2+.007)} 0" rpy="${pi/2} 0 0"/>
      <xacro:detail_round name="${name}_outer_hub" xyz="0 ${side*(geom.wheel_width/2+.002)} 0"
        radius=".047" length=".008" color="${black}" rpy="${pi/2} 0 0"/>
      <xacro:detail_round name="${name}_yoke_top_bolt" xyz=".025 ${-side*(geom.wheel_width/2+.013)} .070"
        radius=".004" length=".003" color="${steel}" rpy="${pi/2} 0 0"/>
      <xacro:detail_round name="${name}_yoke_lower_bolt" xyz="-.027 ${-side*(geom.wheel_width/2+.013)} -.024"
        radius=".004" length=".003" color="${steel}" rpy="${pi/2} 0 0"/>
      <xacro:detail_round name="${name}_steer_pivot" xyz="0 0 .120" radius=".032" length=".037" color="${charcoal}"/>
      <xacro:detail_round name="${name}_axle_fastener" xyz="0 ${side*(geom.wheel_width/2+.007)} 0"
        radius=".009" length=".003" color="${steel}" rpy="${pi/2} 0 0"/>
      <inertial>
        <mass value="1"/>
        <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
      </inertial>
    </link>

    <!-- 这是轮组在车身上的位置，转向节绕竖直轴转。 -->
    <joint name="${name}_steer_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${name}_knuckle"/>
      <origin xyz="${x} ${y} 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-pi/2}" upper="${pi/2}" effort="80" velocity="2.0"/>
    </joint>

    <link name="${name}_wheel">
      <xacro:detail_mesh name="${name}_tread_and_sidewall" file="wheel_tread_unit" color=".034 .036 .040 1"
        scale="${geom.wheel_radius} ${geom.wheel_width} ${geom.wheel_radius}"/>
      <xacro:detail_round name="${name}_outer_rim" xyz="0 ${side*(geom.wheel_width/2+.001)} 0" radius=".072"
        length=".003" rpy="${pi/2} 0 0" color=".019 .022 .025 1"/>
      <xacro:detail_round name="${name}_inner_rim" xyz="0 ${-side*(geom.wheel_width/2+.001)} 0" radius=".070"
        length=".003" rpy="${pi/2} 0 0" color=".022 .025 .029 1"/>
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${geom.wheel_radius}" length="${geom.wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="4"/>
        <inertia ixx="0.0168" ixy="0" ixz="0" iyy="0.0288" iyz="0" izz="0.0168"/>
      </inertial>
    </link>

    <!-- 驱动轴跟着转向节一起改变方向。 -->
    <joint name="${name}_drive_joint" type="continuous">
      <parent link="${name}_knuckle"/>
      <child link="${name}_wheel"/>
      <axis xyz="0 1 0"/>
      <limit effort="55" velocity="16"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="fl" x="${geom.half_wheelbase}" y="${geom.half_track}"/>
  <xacro:wheel name="fr" x="${geom.half_wheelbase}" y="${-geom.half_track}"/>
  <xacro:wheel name="rl" x="${-geom.half_wheelbase}" y="${geom.half_track}"/>
  <xacro:wheel name="rr" x="${-geom.half_wheelbase}" y="${-geom.half_track}"/>

  <xacro:macro name="wheel_interfaces" params="name">
    <joint name="${name}_steer_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="${name}_drive_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <xacro:wheel_interfaces name="fl"/>
    <xacro:wheel_interfaces name="fr"/>
    <xacro:wheel_interfaces name="rl"/>
    <xacro:wheel_interfaces name="rr"/>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
    </plugin>
  </gazebo>
  <xacro:workshop_rack/>

  <link name="lidar_link">
    <xacro:lidar_body/>
    <inertial>
      <mass value="1.6"/>
      <inertia ixx=".003" ixy="0" ixz="0" iyy=".003" iyz="0" izz=".003"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${geom.lidar_xyz}" rpy="${geom.lidar_rpy}"/>
  </joint>
  <gazebo reference="lidar_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <xacro:property name="c32_samples" value="${int(round(20000 / sensor.c32.rate_hz))}"/>
  <xacro:property name="c32_step" value="${2 * pi / c32_samples}"/>

  <gazebo reference="lidar_link">
    <sensor name="lidar_link" type="gpu_lidar">
      <topic>/lidar</topic>
      <ignition_frame_id>lidar_link</ignition_frame_id>
      <always_on>true</always_on>
      <update_rate>${sensor.c32.rate_hz}</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>${c32_samples}</samples>
            <resolution>1</resolution>
            <min_angle>${-pi + c32_step / 2}</min_angle>
            <max_angle>${pi - c32_step / 2}</max_angle>
          </horizontal>
          <vertical>
            <samples>32</samples>
            <resolution>1</resolution>
            <min_angle>${-16 * pi / 180}</min_angle>
            <max_angle>${15 * pi / 180}</max_angle>
          </vertical>
        </scan>
        <range>
          <min>${sensor.c32.min_range_m}</min>
          <max>${sensor.c32.max_range_m}</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0</mean>
          <stddev>${sensor.c32.range_stddev_m}</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>
  <link name="imu_link">
    <xacro:detail_mesh name="h30_metal_enclosure" file="h30_metal" color="${steel}"
      xyz=".0215 0 .0055" rpy="${pi} 0 0" scale=".001 .001 .001"/>
    <inertial>
      <mass value="0.055"/>
      <inertia ixx=".000011" ixy="0" ixz="0" iyy=".000014" iyz="0" izz=".000020"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${geom.imu_xyz}" rpy="${geom.imu_rpy}"/>
  </joint>
  <gazebo reference="imu_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <xacro:macro name="h30_axis_noise" params="sigma bias">
    <noise type="gaussian">
      <mean>0</mean>
      <stddev>${sigma}</stddev>
      <dynamic_bias_stddev>${bias}</dynamic_bias_stddev>
      <dynamic_bias_correlation_time>100</dynamic_bias_correlation_time>
    </noise>
  </xacro:macro>

  <xacro:macro name="h30_axes" params="density bandwidth bias">
    <xacro:property name="sigma" value="${density * sqrt(bandwidth)}"/>
    <x><xacro:h30_axis_noise sigma="${sigma}" bias="${bias}"/></x>
    <y><xacro:h30_axis_noise sigma="${sigma}" bias="${bias}"/></y>
    <z><xacro:h30_axis_noise sigma="${sigma}" bias="${bias}"/></z>
  </xacro:macro>

  <gazebo reference="imu_link">
    <sensor name="imu_link" type="imu">
      <topic>/imu/gazebo</topic>
      <ignition_frame_id>imu_link</ignition_frame_id>
      <always_on>true</always_on>
      <update_rate>${sensor.h30.rate_hz}</update_rate>
      <imu>
        <angular_velocity>
          <xacro:h30_axes
            density="${sensor.h30.gyro_noise_deg_s_sqrt_hz * pi / 180}"
            bandwidth="${sensor.h30.gyro_bandwidth_hz}"
            bias="${sensor.h30.gyro_bias_instability_deg_h * pi / (180 * 3600)}"/>
        </angular_velocity>
        <linear_acceleration>
          <xacro:h30_axes
            density="${sensor.h30.accel_noise_ug_sqrt_hz * 1e-6 * 9.80665}"
            bandwidth="${sensor.h30.accel_bandwidth_hz}"
            bias="${sensor.h30.accel_bias_instability_mg * 0.001 * 9.80665}"/>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>


</robot>