<?xml version="1.0"?>
<robot name="fw_mid" xmlns:xacro="http://www.ros.org/wiki/xacro"> 
  <xacro:arg name="geometry_file" default="$(find fw_mid_sim)/config/geometry.yaml"/>
  <xacro:arg name="controllers_file" default="$(find fw_mid_sim)/config/controllers.yaml"/>
  <xacro:property name="geometry_file" value="$(arg geometry_file)"/>
  <xacro:property name="geom" value="${xacro.load_yaml(geometry_file)}"/>

  <link name="base_footprint"/>
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.165"/>
      <geometry><box size="0.68 0.55 0.22"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.165"/>
      <geometry><box size="0.68 0.55 0.22"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.145"/>
      <mass value="52"/>
      <inertia ixx="2.15" ixy="0" ixz="0" iyy="2.84" iyz="0" izz="3.31"/>
    </inertial>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${geom.wheel_radius}"/>
  </joint>

  <xacro:macro name="wheel" params="name x y">
    <link name="${name}_knuckle">
      <inertial>
        <mass value="1"/>
        <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
      </inertial>
    </link>

    <!-- 这是轮组在车身上的位置，转向节绕竖直轴转。 -->
    <joint name="${name}_steer_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${name}_knuckle"/>
      <origin xyz="${x} ${y} 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-pi/2}" upper="${pi/2}" effort="80" velocity="2.0"/>
    </joint>

    <link name="${name}_wheel">
      <visual>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${geom.wheel_radius}" length="${geom.wheel_width}"/></geometry>
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${geom.wheel_radius}" length="${geom.wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="4"/>
        <inertia ixx="0.0168" ixy="0" ixz="0" iyy="0.0288" iyz="0" izz="0.0168"/>
      </inertial>
    </link>

    <!-- 驱动轴跟着转向节一起改变方向。 -->
    <joint name="${name}_drive_joint" type="continuous">
      <parent link="${name}_knuckle"/>
      <child link="${name}_wheel"/>
      <axis xyz="0 1 0"/>
      <limit effort="55" velocity="16"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="fl" x="${geom.half_wheelbase}" y="${geom.half_track}"/>
  <xacro:wheel name="fr" x="${geom.half_wheelbase}" y="${-geom.half_track}"/>
  <xacro:wheel name="rl" x="${-geom.half_wheelbase}" y="${geom.half_track}"/>
  <xacro:wheel name="rr" x="${-geom.half_wheelbase}" y="${-geom.half_track}"/>

  <xacro:macro name="wheel_interfaces" params="name">
    <joint name="${name}_steer_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="${name}_drive_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <xacro:wheel_interfaces name="fl"/>
    <xacro:wheel_interfaces name="fr"/>
    <xacro:wheel_interfaces name="rl"/>
    <xacro:wheel_interfaces name="rr"/>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
    </plugin>
  </gazebo>
</robot>