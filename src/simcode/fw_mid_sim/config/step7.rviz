Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ''
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Saved Map
      Enabled: true
      Alpha: 1
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Enabled: true
      Alpha: 0.35
      Color Scheme: costmap
      Topic:
        Value: /global_costmap/costmap
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Path
      Name: Planned Path
      Enabled: true
      Color: 255; 100; 0
      Line Style: Billboards
      Line Width: 0.035
      Topic:
        Value: /plan
        Durability Policy: Volatile
        Reliability Policy: Reliable
  Global Options:
    Fixed Frame: map
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 140
      X: 1.2
      Y: 0
Window Geometry:
  Width: 900
  Height: 640
